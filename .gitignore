.DS_Store
node_modules/
.vercel

# Stray headless-test screenshots. The negation is what lets the site's own
# images ship: favicon, app icons, share cards. Anything outside
# site/public is dropped by `git add -A` in SILENCE, which is how the two
# share cards imported into merge/ were never committed. A check in
# test_site.py now fails if a page asks for an image the build lacks.
*.png
!site/public/**/*.png
# The phone apps' icons and splash screens, and the art they are made from.
!mobile/assets/*.png
!mobile/android/app/src/main/res/**/*.png
!mobile/ios/App/App/Assets.xcassets/**/*.png

# local deploy cron state
.deploy-state
ops/deploy.log

# Build output and machine-local files. public/ is written by `npm run build`
# from site/public on every deploy; a committed copy only goes stale.
/public/
/build/
/.gradle/
/.idea/
/.kotlin/
/local.properties
*.iml
